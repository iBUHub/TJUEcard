# 服务器配置
PORT=3000
FRONTEND_PORT=5173

# 后端 API 地址（供 Agent 连接使用，本地开发通常为 http://localhost:PORT）
API_BASE_URL=http://localhost:3000

# JWT 密钥（可随机生成长字符串，用于 API 认证）
JWT_SECRET=your_jwt_secret_here

# Agent 密钥（可随机生成长字符串）
AGENT_SECRET=your_agent_secret_here

# 本地开发模式：设置为 true 可跳过邮箱验证码校验
SKIP_EMAIL_VERIFICATION=true

# SendCloud 邮件服务配置（本地开发若开启 SKIP_EMAIL_VERIFICATION 则可不配）
SEND_CLOUD_API_USER=
SEND_CLOUD_API_KEY=
SEND_CLOUD_FROM_EMAIL=
SEND_CLOUD_TEST_EMAIL=

# TJU 办公网账号配置（用于 Agent 本地开发）
TJU_USERNAME=your_username_here
TJU_PASSWORD=your_password_here
