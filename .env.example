# 后端 API 地址（供 Agent 连接使用）
API_BASE_URL=http://localhost:3000

# JWT 密钥（可随机生成长字符串，用于 API 认证）
JWT_SECRET=your_jwt_secret_here

# Agent 密钥（可随机生成长字符串）
AGENT_SECRET=your_agent_secret_here

# 本地开发模式：设置为 true 可跳过邮箱验证码校验
SKIP_EMAIL_VERIFICATION=true

# 邮件服务选择：留空/不设置为原 SendCloud，设置为 resend 时使用 Resend
EMAIL_PROVIDER=

# SendCloud 邮件服务配置（本地开发若开启 SKIP_EMAIL_VERIFICATION 则可不配）
SEND_CLOUD_API_USER=
SEND_CLOUD_API_KEY=
SEND_CLOUD_FROM_EMAIL=
SEND_CLOUD_TEST_EMAIL=

# Resend 邮件服务配置（当 EMAIL_PROVIDER=resend 时需要）
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TEST_EMAIL=

# TJU 办公网账号配置（用于 Agent 本地开发）
TJU_USERNAME=your_username_here
TJU_PASSWORD=your_password_here
